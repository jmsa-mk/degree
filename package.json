{
  "name": "degreebee-focus",
  "version": "2.2.1",
  "description": "DegreeBee Focus - desktop monitoring, personal progress and study league",
  "author": "DegreeBee",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke-test.mjs",
    "dist": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:feedback": "node scripts/feedback-test.mjs",
    "test:exports": "node scripts/export-test.mjs",
    "test:accounts": "node scripts/account-api-test.mjs",
    "test:community": "node scripts/community-test.mjs",
    "test:subscriptions": "node scripts/subscription-test.mjs",
    "test:demo": "node scripts/demo-checkout-test.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.degreebee.focus",
    "productName": "DegreeBee Focus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "artifactName": "DegreeBee-Focus-${version}-${arch}.${ext}"
  }
}
